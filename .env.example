# Korvex — variáveis de ambiente (valores demonstrativos, NÃO são segredos reais)
# O protótipo atual (apps/web) não usa nenhuma destas variáveis: roda 100% no navegador.
# Elas documentam o que a versão de produção vai exigir.

# Ambiente
APP_ENV=development            # development | staging | production
APP_URL=http://localhost:5173
DEFAULT_TIMEZONE=America/Sao_Paulo

# Supabase (banco, autenticação, storage privado)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=coloque-a-chave-publica-aqui          # pode ir ao cliente
SUPABASE_SERVICE_ROLE_KEY=somente-no-servidor           # NUNCA expor no cliente
SUPABASE_PHOTOS_BUCKET=progress-photos                  # bucket privado
PHOTO_SIGNED_URL_TTL_SECONDS=300

# Provedor de IA (somente servidor)
AI_PROVIDER=anthropic          # anthropic | demo
AI_MODEL=claude-sonnet-5-5
AI_API_KEY=somente-no-servidor
AI_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=4000
AI_MAX_ATTEMPTS=3
AI_PRICE_IN_CENTS_PER_MTOK=1500    # referência para estimativa de custo
AI_PRICE_OUT_CENTS_PER_MTOK=7500

# Pagamentos (Mercado Pago — assinaturas)
MP_ACCESS_TOKEN=somente-no-servidor
MP_WEBHOOK_SECRET=somente-no-servidor
MP_PLAN_ID_ESSENCIAL=
MP_PLAN_ID_PROFISSIONAL=
MP_PLAN_ID_STUDIO=
BILLING_GRACE_DAYS=7

# E-mail transacional
EMAIL_PROVIDER=resend
EMAIL_API_KEY=somente-no-servidor
EMAIL_FROM="Korvex <nao-responda@exemplo.com>"

# Agendador de ciclos
CRON_SECRET=somente-no-servidor   # protege a rota chamada pelo cron
CYCLE_DEFAULT_DAYS=45

# Observabilidade
SENTRY_DSN=
LOG_LEVEL=info

# Gemini (fase de teste, plano gratuito; só alunos fictícios). Configurar na Vercel.
GEMINI_API_KEY=somente-no-servidor
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
